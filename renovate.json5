{
    '$schema': 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'github>Lombiq/renovate-config:default.json5',
        'github>Lombiq/Open-Source-Orchard-Core-Extensions:renovate-osoce-submodule.json5',
        // Due to having to update branch references, it's easier to test all dependencies at once.
        'github>Lombiq/renovate-config:all-dependencies.json5',
    ],
    packageRules: [
        {
            matchPackageNames: ['azure/webapps-deploy'],
            matchFileNames: ['.github/workflows/deploy-orchard1-to-azure-app-service.yml'], 
            enabled: false,
        },
        // Disabling until https://github.com/NishargShah/eslint-config-airbnb-extended/issues/8 is fixed.
        {
            matchPackageNames: ['@stylistic/eslint-plugin', '@eslint/compat'],
            enabled: false,
        },
    ],
    postUpgradeTasks: {
        commands: [
            // Replace @dev with @<branchName> in all YAML files in a separate commit so Renovate changes are easier to
            // test run. Linux-specific script because Renovate only runs under Linux anyway.
            // We need can't use the Mend Renovate app due to its restrictions on postUpgradeTasks commands (see
            // https://docs.renovatebot.com/configuration-options/#postupgradetasks), so need to use run the GHA workflow.
            'find . -path "*.yml" -type f -exec sed --in-place "s|@dev|@{{branchName}}|g" {} +',
        ],
        executionMode: 'update',
    }
}
