{
    '$schema': 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'github>Lombiq/renovate-config:default.json5',
        'github>Lombiq/Open-Source-Orchard-Core-Extensions:renovate-osoce-submodule.json5',
        // Due to having to update branch references, it's easier to test all dependencies at once.
        'github>Lombiq/renovate-config:all-dependencies.json5',
    ],
    customManagers: [
        {
            customType: 'regex',
            managerFilePatterns: ['/.github/actions/twitter-together/action\\.yml$/'],
            matchStrings: ['TWITTER_TOGETHER_REF: (?<currentDigest>[a-f0-9]{40}) # (?<currentValue>v[0-9.]+)'],
            datasourceTemplate: 'github-tags',
            depNameTemplate: 'twitter-together/action',
        },
    ],
    packageRules: [
        {
            matchPackageNames: ['azure/webapps-deploy'],
            matchFileNames: ['.github/workflows/deploy-orchard1-to-azure-app-service.yml'], 
            enabled: false,
        },
        // Disabling until https://github.com/eslint-config/airbnb-extended/issues/65 is fixed.
        {
            matchPackageNames: ['/.?eslint.?/'],
            enabled: false,
        },
    ]
}
